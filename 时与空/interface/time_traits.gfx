	# 神秘奇点
	spriteType = {
		name = "GFX_leader_trait_ruler_time"
		texturefile = "gfx/interface/icons/traits/leader_trait_ruler_time.dds"
		effectFile = "gfx/FX/buttonstate.shader"
		animation = {
			animationmaskfile = "gfx/interface/icons/traits/leader_traits/trait_time_mask.dds"
			animationtexturefile = "gfx/interface/icons/traits/leader_traits/trait_time_animated_texture.dds"  	# <- the animated file
			animationrotation = 90.0		# -90 clockwise 90 counterclockwise(by default)
			animationlooping = yes			# yes or no ;)
			animationtime = 7				# in seconds
			animationdelay = 0			# in seconds
			animationblendmode = "add"       #add, multiply, overlay
			animationtype = "rotating"      #scrolling, rotating, pulsing
			animationrotationoffset = { x = 0.0 y = 0.0 }
			animationtexturescale = { x = 1.0 y = 1.0 }
		}
		legacy_lazy_load = no
	}
	
	spriteType = {
		name = "GFX_leader_trait_ruler_time_without_animation"
