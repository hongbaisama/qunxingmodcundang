				text = "zone_available"
				maxWidth = 150
				maxHeight = 50
				fixedSize = yes
				format = left
				orientation = upper_left
				vertical_alignment = center
			}

			instantTextBoxType = {
				name = "zone_unavailable"
				font = "cg_16b"
				position = { x = 120 y = 67 }
				text = ""
				maxWidth = 150
				maxHeight = 50
				fixedSize = yes
				format = left
				orientation = upper_left
				vertical_alignment = center
			}
		}

		#Secondary Zones
		gridBoxType = {
