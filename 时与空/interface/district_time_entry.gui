guiTypes = {
	containerWindowType = {
		name = "planet_district_time_entry"
		size = { width = 561 height = 170 }
		position = { x = 0 y = 0 }

		background = {
			position = { x = 0 y = 1 }
			name = "districts_window_background"
			spriteType = "GFX_dark_area"
			alwaysTransparent = yes
		}

		buttonType ={
			name = "selection_highlight"
			spriteType = "GFX_glow_tile_orange_no_padding"
			position = { x = 0 y = 0 }
			size = { x = 561 y = 170 }
			alwaystransparent = yes
		}

		buttonType = {
			name = "district_button"
			position = { x = 0 y = 0 }
			size = { x = 561 y = 170 }
			quadTextureSprite = "GFX_district_hover"
			clicksound = "menu_slide_open"
		}

		instantTextBoxType = {
			name = "name"
			font = "cg_16b"
			text = "District Name"
			position = { x = 6 y = 4 }
			maxWidth = 500
			maxHeight = 16
			fixedSize = yes
			truncate = yes
			format = left
			alwaysTransparent = yes
		}

		instantTextBoxType = {
			name = "triggered_name"
			font = "cg_16b"
			text_color_code = "Y"
			text = "Triggered Name"
			position = { x = 5  y = 18 }
			maxWidth = 500
			maxHeight = 16
			fixedSize = yes
			truncate = yes
			format = left
			alwaysTransparent = yes
		}
		
		################################################################
		# 岗位专精
		################################################################
		
		# 图标空隙为12应共用，故x之间差距为174-12=162
		@focus_on_black_hole_researcher_x = -256
		@focus_on_black_hole_researcher_y = -5
		
		effectButtonType = {
			name = "focus_on_black_hole_default"
			spriteType = "GFX_button_150_24"
			position = { x = @focus_on_black_hole_researcher_x y = @focus_on_black_hole_researcher_y }
			text = "focus_on_black_hole_default"
			font = "cg_16b"
			orientation = UPPER_RIGHT
			shortcut = "RETURN"
			clicksound = "tab_click"
			oversound = mouse_over
			effect = focus_on_black_hole_default_effect
		}
		
		effectButtonType = {
			name = "focus_on_black_hole_physicist"
			spriteType = "GFX_button_focus_on_black_hole_researcher"
			position = { x = @focus_on_black_hole_researcher_x y = @focus_on_black_hole_researcher_y }
			text = "focus_on_black_hole_physicist"
			font = "cg_16b"
			orientation = UPPER_RIGHT
			shortcut = "RETURN"
			clicksound = "tab_click"
			oversound = mouse_over
			effect = focus_on_black_hole_physicist_effect
		}
		
		effectButtonType = {
			name = "focus_on_black_hole_biologist"
			spriteType = "GFX_button_focus_on_black_hole_researcher"
			position = { x = @focus_on_black_hole_researcher_x y = @focus_on_black_hole_researcher_y }
			text = "focus_on_black_hole_biologist"
			font = "cg_16b"
			orientation = UPPER_RIGHT
			shortcut = "RETURN"
			clicksound = "tab_click"
			oversound = mouse_over
			effect = focus_on_black_hole_biologist_effect
		}
		
		effectButtonType = {
			name = "focus_on_black_hole_engineer"
			spriteType = "GFX_button_focus_on_black_hole_researcher"
			position = { x = @focus_on_black_hole_researcher_x y = @focus_on_black_hole_researcher_y }
			text = "focus_on_black_hole_engineer"
			font = "cg_16b"
			orientation = UPPER_RIGHT
			shortcut = "RETURN"
			clicksound = "tab_click"
			oversound = mouse_over
			effect = focus_on_black_hole_engineer_effect
		}
		
		################################################################
		# 岗位专精
		################################################################

		buttonType = {
			name = "build_district"
			position = { x = -94 y = -5 }
			spriteType = "GFX_button_animated_75_24"
			buttonFont = "cg_16b"
			text = "BUILD_DISTRICT_BUTTON"
			font = "cg_16b"
			orientation = UPPER_RIGHT
			oversound = mouse_over
			pdx_tooltip = "BUILD_DISTRICT"
			clicksound = "ui_queuing_district"
		}

		buttonType = {
			name = "district_icon_frame"
