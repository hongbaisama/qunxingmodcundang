				size = { width = 48 height = 48 }
				format = "UPPER_LEFT"
				slotsize = { width = 52 height = 52 }
				add_horizontal = yes
				max_slots_horizontal = 3
				max_slots_vertical = 2
			}

			buttonType = {
				name = "zone_button"
				position = { x= 80 y= 68 }
