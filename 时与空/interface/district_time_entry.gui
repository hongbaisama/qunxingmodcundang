				position = { x = -1 y = 0 }
				text = "10"
				maxWidth = 52
				maxHeight = 20
				fixedSize = yes
				format = center
			}
		}

		#Primary Zone
		containerWindowType = {
			name = "zone"
			position = { x = 83 y = 36 }
			size = { width = 164 height = 102 }

			buttonType ={
				name = "selection_highlight"
